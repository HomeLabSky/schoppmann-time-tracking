# Vorlage für deploy/.env  (die .env wird NICHT eingecheckt)
#   cp .env.example .env

# Interner Name ohne https://, der im Firmennetz auf diesen Server zeigt (DNS-Eintrag oder hosts-Datei).
# Nicht "...local" verwenden (kollidiert mit mDNS); besser z. B. zeit.firma.de oder zeit.firma.intern
DOMAIN=zeit.firma.de

# Zwei verschiedene, zufällige Geheimnisse (je mind. 32 Zeichen). Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Zertifikat: "internal" (Standard) = Caddy stellt eine eigene interne Zertifizierungsstelle bereit.
# Alternativen: "/certs/fullchain.pem /certs/privkey.pem" (eigenes Zertifikat in deploy/certs)
# oder eine E-Mail-Adresse für Let's Encrypt (nur wenn der Server aus dem Internet erreichbar ist).
TLS_MODE=internal

# Ordner AUF DEM DOCKER-HOST, in den die NAS-Freigabe eingebunden ist (siehe README, Abschnitt 3).
# In diesem Ordner muss die Datei .zeiterfassung-offsite liegen.
NAS_BACKUP_DIR=/mnt/nas-zeiterfassung

# Selbstregistrierung (Standard aus: Konten legt ein Admin an)
ALLOW_REGISTRATION=false
# Optional: nur diese E-Mail-Domains zulassen (kommagetrennt)
ALLOWED_EMAIL_DOMAINS=

# Sicherung: Uhrzeit (Ortszeit gemäß TZ), Aufbewahrung lokal und auf dem NAS (je eine Sicherung pro Tag)
TZ=Europe/Berlin
BACKUP_TIME=02:30
BACKUP_KEEP=30
NAS_KEEP=90
