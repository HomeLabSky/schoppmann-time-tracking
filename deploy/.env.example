# Vorlage für deploy/.env  (die .env wird NICHT eingecheckt)
#   cp .env.example .env

# Interner Name ohne https://, der im Firmennetz auf diesen Server zeigt (DNS-Eintrag oder hosts-Datei).
# Nicht "...local" verwenden (kollidiert mit mDNS); besser z. B. zeit.firma.de oder zeit.firma.intern
DOMAIN=zeit.firma.de

# Zwei verschiedene, zufällige Geheimnisse (je mind. 32 Zeichen). Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Zertifikat: "internal" (Standard) = Caddy stellt eine eigene interne Zertifizierungsstelle bereit.
# Alternativen: "/certs/fullchain.pem /certs/privkey.pem" (eigenes Zertifikat in deploy/certs)
# oder eine E-Mail-Adresse für Let's Encrypt (nur wenn der Server aus dem Internet erreichbar ist).
TLS_MODE=internal

# Ordner AUF DEM DOCKER-HOST, in den die NAS-Freigabe eingebunden ist (siehe README, Abschnitt 3).
# In diesem Ordner muss die Datei .zeiterfassung-offsite liegen.
NAS_BACKUP_DIR=/mnt/nas-zeiterfassung

# Selbstregistrierung (Standard aus: Konten legt ein Admin an)
ALLOW_REGISTRATION=false
# Optional: nur diese E-Mail-Domains zulassen (kommagetrennt)
ALLOWED_EMAIL_DOMAINS=

# Anfragen je Gerät (IP) in 15 Minuten. Bei der Meldung "Zu viele Anfragen" erhöhen.
# Die Anmeldung bleibt unabhängig davon streng begrenzt (5 Fehlversuche, danach Kontosperre).
RATE_LIMIT_MAX_REQUESTS=1000

# Lohnzettel (PDF): Firmenanschrift im Kopf, kommagetrennte Zeilen (leer = nur Logo)
PAYSLIP_COMPANY_ADDRESS=

# Lohnabrechnung per E-Mail (Button "An Buchhaltung senden" unter Zeitnachweise). Empfänger und Text stehen in der
# Oberfläche unter Einstellungen; hier nur der Mailserver. SMTP_HOST leer = Versand aus.
# Exchange, anonymes Relay (Empfangsconnector erlaubt die IP dieses Servers): SMTP_HOST=exchange.firma.local, SMTP_PORT=25,
#   SMTP_USER leer lassen.
# Exchange mit Anmeldung (AD-Konto, z. B. Dienstkonto mit eigenem Postfach): SMTP_PORT=587, SMTP_USER=DOMAIN\konto oder
#   konto@firma.de, SMTP_PASSWORD=…; SMTP_FROM muss dieses Postfach sein (oder "Senden als"-Recht haben).
# Zertifikat der internen Zertifizierungsstelle: NODE_EXTRA_CA_CERTS auf die CA-Datei setzen oder notfalls
#   SMTP_TLS_REJECT_UNAUTHORIZED=false.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Sicherung: Uhrzeit (Ortszeit gemäß TZ), Aufbewahrung lokal und auf dem NAS (je eine Sicherung pro Tag)
TZ=Europe/Berlin
BACKUP_TIME=02:30
BACKUP_KEEP=30
NAS_KEEP=90
