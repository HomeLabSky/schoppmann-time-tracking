# Vorlage für deploy/.env  (die .env wird NICHT eingecheckt)
#   cp .env.example .env

# Öffentliche Adresse ohne https://  (DNS muss auf den Server zeigen, Ports 80 und 443 offen)
DOMAIN=zeit.example.de

# Zwei verschiedene, zufällige Geheimnisse (je mind. 32 Zeichen). Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Selbstregistrierung (Standard aus: Konten legt ein Admin an)
ALLOW_REGISTRATION=false
# Optional: nur diese E-Mail-Domains zulassen (kommagetrennt)
ALLOWED_EMAIL_DOMAINS=

# Anzahl aufbewahrter Datenbank-Sicherungen (eine pro Tag)
BACKUP_KEEP=30
