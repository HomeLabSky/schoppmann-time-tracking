# Caddy: HTTPS und Weiterleitung an Frontend/Backend.
# Adresse und Zertifikatsart kommen aus deploy/.env:
#   DOMAIN    z. B. zeit.firma.de (interner DNS-Name, der auf diesen Server zeigt)
#   TLS_MODE  internal                                   → eigene interne Zertifizierungsstelle (Standard)
#             /certs/fullchain.pem /certs/privkey.pem    → eigenes Zertifikat (Dateien in deploy/certs)
#             admin@firma.de                             → Let's Encrypt (nur mit öffentlich erreichbarem Server)

{
	# Greift man per IP-Adresse zu, sendet der Browser keinen Servernamen (SNI), und im Container ist die lokale
	# Adresse nicht die Server-IP. Ohne Standardname bricht Caddy dann mit "internal error" ab.
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	tls {$TLS_MODE:internal}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API
	handle /api/* {
		reverse_proxy backend:5000
	}

	# alles andere: Oberfläche
	handle {
		reverse_proxy frontend:3000
	}
}
