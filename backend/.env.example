# =================================
# ENVIRONMENT TEMPLATE
# =================================
# Kopieren zu .env und Werte anpassen

# Server Configuration
NODE_ENV=production
PORT=5000

# JWT Secrets (STARKE SCHLÜSSEL GENERIEREN!)
JWT_SECRET=your_super_strong_jwt_secret_here
JWT_REFRESH_SECRET=your_super_strong_refresh_secret_here

# Database Configuration
DB_DIALECT=sqlite
DB_STORAGE=./database/timetracking.db
DB_LOGGING=false

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# Logging
LOG_LEVEL=info