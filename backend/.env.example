# =================================
# ENVIRONMENT TEMPLATE
# =================================
# Kopieren zu backend/.env und Werte anpassen. Die .env wird NICHT eingecheckt.
# Ohne JWT_SECRET / JWT_REFRESH_SECRET (mind. 32 Zeichen) startet das Backend nicht.

# Server Configuration
# Standard ist "production". Für lokale Entwicklung: development
NODE_ENV=production
PORT=5000
# Hinter einem Reverse-Proxy (nginx, Traefik, …): Anzahl der Proxys, sonst leer lassen
# TRUST_PROXY=1

# JWT Secrets – zwei verschiedene, zufällige Werte erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database Configuration
# Relative Pfade gelten ab dem Ordner backend/ (unabhängig vom Startverzeichnis).
# Regelmäßig sichern: die .db-Datei enthält alle Benutzer und Zeiteinträge.
DB_DIALECT=sqlite
DB_STORAGE=./database/timetracking.db
DB_LOGGING=false

# CORS Configuration (Adresse des Frontends, kommagetrennt)
CORS_ORIGIN=http://localhost:3000

# Selbstregistrierung (Standard: aus – Konten legt ein Admin an)
# Zum Aktivieren auch im Frontend NEXT_PUBLIC_ALLOW_REGISTRATION=true setzen
ALLOW_REGISTRATION=false
# Optional: nur diese E-Mail-Domains zulassen (kommagetrennt, leer = alle)
# ALLOWED_EMAIL_DOMAINS=schoppmann.de

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# Logging
LOG_LEVEL=info
