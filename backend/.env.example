# =================================
# ENVIRONMENT TEMPLATE
# =================================
# Kopieren zu backend/.env und Werte anpassen. Die .env wird NICHT eingecheckt.
# Alle Werte werden beim Start geprüft: Fehlt ein Pflichtwert (JWT_SECRET / JWT_REFRESH_SECRET, mind. 32 Zeichen)
# oder ist ein Wert ungültig (z. B. PORT=abc), startet das Backend nicht und nennt die Variable.

# Server Configuration
# Standard ist "production". Für lokale Entwicklung: development
NODE_ENV=production
PORT=5000
# Hinter einem Reverse-Proxy (nginx, Traefik, …): Anzahl der Proxys, sonst leer lassen
# TRUST_PROXY=1

# Geheimnisse – zwei verschiedene, zufällige Werte erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET signiert die Zugriffs-Tokens, JWT_REFRESH_SECRET sichert die gespeicherten Prüfwerte der
# Erneuerungs-Tokens. Beides ändern = alle Benutzer müssen sich neu anmelden.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Anmeldung – optional, Standardwerte sind für den Betrieb gedacht:
# ACCESS_TOKEN_TTL_SECONDS=900     # Zugriffs-Token (Web und App): 15 Minuten
# REFRESH_TOKEN_TTL_DAYS=7         # Web: Erneuerung gleitend 7 Tage
# SESSION_MAX_DAYS=30              # Web: danach ist eine neue Anmeldung nötig
# APP_REFRESH_TOKEN_TTL_DAYS=30    # App: Erneuerung gleitend 30 Tage
# APP_SESSION_MAX_DAYS=90          # App: danach ist eine neue Anmeldung nötig
# COOKIE_SECURE=false              # Standard: in Produktion true (HTTPS), sonst false

# Konto-Sperre nach Fehlversuchen (je E-Mail-Adresse, zusätzlich zur Begrenzung pro IP)
# LOGIN_LOCK_THRESHOLD=5           # Fehlversuche bis zur Sperre
# LOGIN_LOCK_MINUTES=15            # erste Sperre; jede weitere Serie verdoppelt (höchstens 24 h)

# Database Configuration
# Relative Pfade gelten ab dem Ordner backend/ (unabhängig vom Startverzeichnis).
# Regelmäßig sichern: die .db-Datei enthält alle Benutzer und Zeiteinträge.
DB_STORAGE=./database/timetracking.db
# SQL-Befehle im Log (Stufe debug)
DB_LOGGING=false

# CORS Configuration (Adresse des Frontends, kommagetrennt)
CORS_ORIGIN=http://localhost:3000

# Selbstregistrierung (Standard: aus – Konten legt ein Admin an)
# Zum Aktivieren auch im Frontend NEXT_PUBLIC_ALLOW_REGISTRATION=true setzen
ALLOW_REGISTRATION=false
# Optional: nur diese E-Mail-Domains zulassen (kommagetrennt, leer = alle)
# ALLOWED_EMAIL_DOMAINS=schoppmann.de

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# Alle Anfragen je IP im Zeitfenster (die Oberfläche stellt mehrere Anfragen pro Klick)
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_LOGIN_MAX=5

# Lohnzettel (PDF): Firmenanschrift im Kopf, kommagetrennte Zeilen (leer = nur Logo)
# PAYSLIP_COMPANY_ADDRESS=Musterstraße 1, 12345 Musterstadt

# Logging (JSON je Zeile, ohne personenbezogene Daten): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
