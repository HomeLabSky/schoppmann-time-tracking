{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "node tools/eslint/node_modules/eslint/bin/eslint.js --config tools/eslint/eslint.config.mjs --max-warnings 0 .",
    "lint:fix": "npm run lint -- --fix",
    "lint:install": "npm ci --prefix tools/eslint",
    "start": "node dist/server.js",
    "test": "npm run typecheck && npm run test:unit && npm run smoke",
    "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "tsx test/smoke.ts",
    "e2e:server": "tsx test/e2e-server.ts",
    "openapi": "tsx src/scripts/openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "admin:create": "node dist/scripts/create-admin.js",
    "user:reset-password": "node dist/scripts/reset-password.js",
    "db:backup": "node dist/scripts/backup-db.js",
    "db:restore": "node dist/scripts/restore-db.js",
    "db:backup:loop": "node dist/scripts/backup-loop.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
